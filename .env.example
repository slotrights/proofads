###############################################################################
# ProofAds — copy to .env and fill in. NEVER commit .env.
# For purely local development use .env.local.example instead; those are
# Anvil's well-known keys and hold no value anywhere.
###############################################################################

# ── Chain ────────────────────────────────────────────────────────────────────
SEPOLIA_RPC_URL=https://eth-sepolia.g.alchemy.com/v2/REPLACE_ME
ETHERSCAN_API_KEY=REPLACE_ME
CHAIN_ID=11155111

# ── Wallets (five roles; generate with `cast wallet new`) ────────────────────
DEPLOYER_PRIVATE_KEY=0x
PUBLISHER_PRIVATE_KEY=0x
PUBLISHER_ADDRESS=0x
AGENCY_PRIVATE_KEY=0x
AGENCY_ADDRESS=0x
ADVERTISER_A_PRIVATE_KEY=0x
ADVERTISER_A_ADDRESS=0x
ADVERTISER_B_PRIVATE_KEY=0x
ADVERTISER_B_ADDRESS=0x

# ── ENS ──────────────────────────────────────────────────────────────────────
# The .eth name the publisher owns on the ENSv2 Sepolia beta.
PUBLISHER_LABEL=proofads-pub
PUBLISHER_NAME=proofads-pub.eth
# Filled in after `forge script script/DeploySepolia.s.sol`.
AD_INVENTORY_REGISTRY=0x
# Optional overrides if the ENSv2 beta addresses move (see docs/PROTOCOL_RESEARCH.md).
# ENS_LABEL_STORE=
# ENS_ETH_REGISTRY=
# ENS_VERIFIABLE_FACTORY=
# ENS_USER_REGISTRY_IMPL=
# ENS_PERMISSIONED_RESOLVER_IMPL=
# ENS_ETH_REGISTRAR=
# ENS_MOCK_USDC=

# ── Settlement ───────────────────────────────────────────────────────────────
# Circle's official Sepolia USDC (6 decimals). Not ENS's MockUSDC.
USDC_ADDRESS=0x1c7D4B196Cb0C7B01d743Fbc6116a902379C7238
# Chainlink KeystoneForwarder on Sepolia. Verify before deploying.
KEYSTONE_FORWARDER=0x15fC6ae953E024d975e77382eEeC56A9101f9F88

# ── Measurement collector ────────────────────────────────────────────────────
DATABASE_URL=postgres://user:pass@host:5432/proofads
# Long random value. The Chainlink Vault DON releases this into the enclave, and the
# collector requires it on /internal/*. Must equal SECRET_PROOFADS_API_TOKEN below.
PROOFADS_API_TOKEN=
# Public HTTPS URL of the collector — the enclave must be able to reach it.
API_PUBLIC_URL=https://
RPC_URL=${SEPOLIA_RPC_URL}
MARKET_ADDRESS=0x
PORT=8787

# ── Web ──────────────────────────────────────────────────────────────────────
# apps/web/.env.local is generated by `node scripts/write-web-env.mjs sepolia`.
WEB_RPC_URL=${SEPOLIA_RPC_URL}
DEMO_DOMAIN=proofads.example

# ── Chainlink CRE (workflows/proofads-delivery/.env) ─────────────────────────
CRE_ETH_PRIVATE_KEY=0x
CRE_TARGET=staging-settings
SECRET_PROOFADS_API_TOKEN=

# ── World (not enabled in this build; see docs/WORLD_STATUS.md) ──────────────
# WORLD_APP_ID=
# WORLD_RP_ID=
# WORLD_RP_SIGNING_KEY=
